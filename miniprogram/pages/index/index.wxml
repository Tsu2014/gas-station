<view class="container">
  <view class="card" style="padding:16rpx 24rpx">
    <input placeholder="搜索油站名称" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch"
           style="font-size:28rpx"/>
  </view>

  <view class="muted" style="padding:0 16rpx 16rpx">{{locationText}}</view>

  <view wx:if="{{stations.length === 0}}" class="empty">暂无油站数据</view>

  <view class="card" wx:for="{{stations}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="row-between">
      <text style="font-size:30rpx;font-weight:bold">{{item.name}}</text>
      <text class="tag" wx:if="{{item.distance !== null}}">{{item.distance}} km</text>
    </view>
    <view class="muted" style="margin-top:12rpx">{{item.province}}{{item.city}}{{item.address}}</view>
    <view class="row-between" style="margin-top:12rpx">
      <text class="muted">{{item.businessHours}} · {{item.phone}}</text>
      <text wx:if="{{item.status === 1}}" class="tag">营业中</text>
      <text wx:else class="muted">已停业</text>
    </view>
  </view>

  <view style="height:20rpx"></view>
  <view class="btn-primary" bindtap="scanCode">扫码加油</view>
</view>

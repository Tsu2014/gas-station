.card-title {
  font-weight: bold;
  margin-bottom: 16rpx;
}

.plate-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.station-addr {
  margin-top: 10rpx;
}

.default-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 12rpx;
  text-align: center;
  line-height: 34rpx;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #ff6a00;
  border-color: #ff6a00;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 16rpx 0;
  width: 31%;
  margin: 1%;
  text-align: center;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 1rpx solid #eee;
  font-size: 28rpx;
}

.chip-active {
  background: #fff3e6;
  border-color: #ff6a00;
  color: #ff6a00;
}

.chip-price {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.chip-active .chip-price {
  color: #ff6a00;
}

.inline-input {
  text-align: right;
  width: 220rpx;
}

.remark-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.summary-row {
  padding: 20rpx 10rpx;
}

.tip {
  text-align: center;
  margin-top: 16rpx;
}

/* 进行中的预约 */
.status-card {
  overflow: hidden;
  padding: 0;
}

.status-banner {
  background: linear-gradient(135deg, #ff8a3d, #ff6a00);
  color: #fff;
  padding: 28rpx 24rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: bold;
}

.status-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.info-row {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.plate {
  font-weight: bold;
  background: #f0f5ff;
  border: 1rpx solid #d6e4ff;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  letter-spacing: 2rpx;
}

.cancel-btn {
  margin: 24rpx;
}

/* 预约记录 */
.record-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.record-row:last-child {
  border-bottom: none;
}

.plate-small {
  font-weight: bold;
  letter-spacing: 1rpx;
}

.record-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.status-0 {
  background: #fdf6ec;
  color: #e6a23c;
}

.status-1 {
  background: #f0f9eb;
  color: #67c23a;
}

.status-2 {
  background: #fef0f0;
  color: #f56c6c;
}

.status-3 {
  background: #f4f4f5;
  color: #909399;
}

.record-line {
  margin-top: 6rpx;
}

.reply {
  margin-top: 10rpx;
  background: #fef0f0;
  color: #f56c6c;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}

/* 我的页面样式 */

.plate-no {
  margin-left: 16rpx;
  font-weight: bold;
  background: #f0f5ff;
  border: 1rpx solid #d6e4ff;
  border-radius: 8rpx;
  padding: 2rpx 14rpx;
  letter-spacing: 2rpx;
  color: #303133;
}

.plate-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.plate-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.plate-dialog-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
